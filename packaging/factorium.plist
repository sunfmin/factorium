<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daemon as a launchd agent. `factorium service install` fills in the
  binary (Homebrew's opt path, which outlives upgrades), the PATH it runs
  with (the installing shell's), the database and the log, writes it to
  ~/Library/LaunchAgents and loads it into this user's own domain,
  `user/<uid>`, as a job of the Background session: launchd keeps that domain
  with no desktop login, so a desktop session ending does not stop it, and a
  desktop login loads no second copy into `gui/<uid>`. launchd starts it again
  whenever it exits; `factorium stop` unloads it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{label}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{program}</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{path}</string>
		<key>FACTORIUM_DB</key>
		<string>{db}</string>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{log}</string>
	<key>StandardErrorPath</key>
	<string>{log}</string>
</dict>
</plist>
